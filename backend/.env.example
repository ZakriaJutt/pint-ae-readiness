# Copy to backend/.env and fill in. Never commit a filled-in .env. Names only here.
PINTAE_ENV=local
PINTAE_DATABASE_URL=postgresql+psycopg://pintae_app@localhost:5432/pintae_dev
PINTAE_ADMIN_DATABASE_URL=postgresql+psycopg://zakria@localhost:5432/pintae_dev
PINTAE_PUBLIC_BASE_URL=http://localhost:3105
PINTAE_API_PORT=8105
# Assigned but unused (TRD AD-02: jobs live in PostgreSQL)
PINTAE_REDIS_DB_INDEX=4

# Sign-in keys (B2). Generate locally, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"            -> SECRET_KEY
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())" -> TOTP_KEY
PINTAE_SECRET_KEY=
PINTAE_TOTP_KEY=

# E-mail (B2): local Mailpit, no authentication. Production: same SMTP interface.
PINTAE_SMTP_HOST=127.0.0.1
PINTAE_SMTP_PORT=1025
PINTAE_SMTP_STARTTLS=false
PINTAE_SMTP_USERNAME=
PINTAE_SMTP_PASSWORD=
PINTAE_MAIL_FROM=PINT AE Readiness Desk <no-reply@pintae.invalid>

# Object storage (B2): local MinIO through the S3 API.
PINTAE_STORAGE_BACKEND=s3
PINTAE_S3_ENDPOINT_URL=http://127.0.0.1:9000
PINTAE_S3_REGION=us-east-1
PINTAE_S3_BUCKET=pintae-dev
PINTAE_S3_ACCESS_KEY_ID=
PINTAE_S3_SECRET_ACCESS_KEY=
